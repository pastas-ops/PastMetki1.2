<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/pm_widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚡ Быстрые действия" android:textColor="#FFD21C"
        android:textStyle="bold" android:textSize="15sp" android:paddingBottom="8dp"/>
    <TextView android:id="@+id/quick_note" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:text="＋  Новая заметка"
        android:textColor="#FFFFFF" android:textStyle="bold" android:background="#7544DF"/>
    <TextView android:id="@+id/quick_task" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp"
        android:gravity="center_vertical" android:paddingHorizontal="12dp"
        android:text="✓  Новая задача" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="#167BC4"/>
    <TextView android:id="@+id/quick_calendar" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp"
        android:gravity="center_vertical" android:paddingHorizontal="12dp"
        android:text="▦  Открыть календарь" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="#15966D"/>
</LinearLayout>
